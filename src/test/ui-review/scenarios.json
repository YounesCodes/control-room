{
  "viewports": {
    "normal": { "width": 1440, "height": 900 },
    "narrow": { "width": 960, "height": 640 },
    "compact": { "width": 520, "height": 480 }
  },
  "scenarios": {
    "settings": {
      "states": ["populated", "monitoring", "logs", "diagnostics"],
      "ready": ".app-shell",
      "prepare": {
        "populated": [{ "role": "button", "name": "Open Settings" }],
        "monitoring": [{ "role": "button", "name": "Open Settings" }],
        "logs": [
          { "role": "button", "name": "Open Settings" },
          { "role": "button", "name": "Logs & History", "optional": true }
        ],
        "diagnostics": [
          { "role": "button", "name": "Open Settings" },
          { "role": "button", "name": "App & Diagnostics", "optional": true },
          { "role": "combobox", "name": "Settings category", "option": "app", "optional": true },
          { "selector": ".settings-ssh", "scroll": true }
        ]
      },
      "settled": {
        "populated": ".settings-page",
        "monitoring": ".settings-page",
        "logs": ".settings-page",
        "diagnostics": ".settings-ssh"
      },
      "motion": {
        "description": "Settings category reveal, General to Terminal",
        "target": ".settings-form",
        "button": "Terminal",
        "select": "Settings category",
        "option": "terminal"
      }
    },
    "scratchpad": {
      "states": ["populated", "global"],
      "ready": ".app-shell",
      "prepare": {
        "populated": [{ "selector": "[data-scratchpad-trigger]" }],
        "global": [
          { "selector": "[data-scratchpad-trigger]" },
          { "role": "button", "name": "Global note for all connections" }
        ]
      },
      "settled": {
        "populated": ".scratchpad-popover textarea[aria-label='Connection note']",
        "global": ".scratchpad-popover textarea[aria-label='Global note']"
      },
      "motion": {
        "description": "Scratchpad note switch, Connection to Global",
        "target": ".scratchpad-popover-note:not([hidden])",
        "button": "Global note for all connections",
        "select": "Scratchpad scope",
        "option": "global"
      }
    },
    "dialogs": {
      "states": [
        "connection",
        "connection-error",
        "connection-test",
        "connection-test-error",
        "groups",
        "groups-no-tags",
        "rename",
        "metrics"
      ],
      "ready": ".app-shell",
      "prepare": {
        "connection": [
          { "selector": ".compact-navigation-toggle", "optional": true },
          { "role": "button", "name": "Add connection" }
        ],
        "connection-error": [
          { "selector": ".compact-navigation-toggle", "optional": true },
          { "role": "button", "name": "Add connection" },
          { "selector": ".connection-form button[type='submit']" }
        ],
        "connection-test": [
          { "selector": ".compact-navigation-toggle", "optional": true },
          { "selector": ".host-row", "hover": true },
          { "role": "button", "name": "Open actions for Example host" },
          { "role": "menuitem", "name": "Edit connection" },
          { "role": "button", "name": "Test structured access" }
        ],
        "connection-test-error": [
          { "selector": ".compact-navigation-toggle", "optional": true },
          { "selector": ".host-row", "hover": true },
          { "role": "button", "name": "Open actions for Example host" },
          { "role": "menuitem", "name": "Edit connection" },
          { "role": "button", "name": "Test structured access" }
        ],
        "groups": [
          { "selector": ".compact-navigation-toggle", "optional": true },
          { "role": "button", "name": "Manage groups and tags" }
        ],
        "groups-no-tags": [
          { "selector": ".compact-navigation-toggle", "optional": true },
          { "role": "button", "name": "Manage groups and tags" }
        ],
        "rename": [
          { "selector": ".session-tab-main" },
          { "role": "button", "name": "Rename Example host Workspace" }
        ],
        "metrics": [{ "selector": ".host-metrics-trigger" }]
      },
      "settled": {
        "connection": ".modal.connection-dialog",
        "connection-error": ".connection-form .inline-error",
        "connection-test": ".connection-form [role='status']",
        "connection-test-error": ".connection-form .inline-error",
        "groups-no-tags": ".connection-groups-dialog .connection-tag-create",
        "groups": ".connection-groups-dialog .connection-tag-manage-list:not(:empty)",
        "rename": ".modal.prompt-dialog",
        "metrics": ".host-metrics-panel"
      }
    },
    "ports": {
      "states": ["warnings"],
      "ready": ".app-shell",
      "settled": {
        "warnings": "[role='region'][aria-label='Ports reading warnings']"
      }
    },
    "systemd": {
      "states": ["populated", "empty", "loading", "error", "stale", "overflow"],
      "ready": ".app-shell",
      "prepare": {
        "populated": [{ "selector": ".systemd-inventory .dense-row", "last": true }],
        "stale": [
          { "selector": ".systemd-inventory .dense-row", "last": true },
          { "role": "button", "name": "Refresh systemd units" }
        ],
        "overflow": [{ "selector": ".systemd-inventory .dense-row", "last": true }]
      },
      "settled": {
        "populated": ".systemd-memory-value > [aria-hidden]",
        "stale": ".systemd-page .inline-warning",
        "overflow": ".systemd-memory-value > [aria-hidden]",
        "loading": ".connection-section .panel-state[aria-live]",
        "empty": ".systemd-inventory .panel-state",
        "error": ".connection-section .panel-state-error"
      }
    }
  }
}
