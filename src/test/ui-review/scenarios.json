{
  "viewports": {
    "normal": {
      "width": 1440,
      "height": 900
    },
    "narrow": {
      "width": 960,
      "height": 640
    },
    "compact": {
      "width": 520,
      "height": 480
    }
  },
  "scenarios": {
    "settings": {
      "states": [
        "populated",
        "monitoring",
        "logs",
        "diagnostics",
        "update-failed",
        "save-failed",
        "linux-package",
        "linux-font"
      ],
      "ready": ".app-shell",
      "prepare": {
        "populated": [
          {
            "role": "button",
            "name": "Open Settings"
          }
        ],
        "monitoring": [
          {
            "role": "button",
            "name": "Open Settings"
          }
        ],
        "logs": [
          {
            "role": "button",
            "name": "Open Settings"
          },
          {
            "role": "button",
            "name": "Logs & History",
            "optional": true
          },
          {
            "role": "combobox",
            "name": "Settings category",
            "option": "logs",
            "optional": true
          }
        ],
        "diagnostics": [
          {
            "role": "button",
            "name": "Open Settings"
          },
          {
            "role": "button",
            "name": "App & Diagnostics",
            "optional": true
          },
          {
            "role": "combobox",
            "name": "Settings category",
            "option": "app",
            "optional": true
          },
          {
            "selector": ".settings-ssh",
            "scroll": true
          }
        ],
        "update-failed": [
          {
            "role": "button",
            "name": "Open Settings"
          },
          {
            "role": "button",
            "name": "App & Diagnostics",
            "optional": true
          },
          {
            "role": "combobox",
            "name": "Settings category",
            "option": "app",
            "optional": true
          },
          {
            "role": "button",
            "name": "Check for updates"
          }
        ],
        "save-failed": [
          {
            "role": "button",
            "name": "Open Settings"
          },
          {
            "role": "checkbox",
            "name": "Show host metrics in header"
          },
          {
            "selector": ".settings-save"
          }
        ],
        "linux-package": [
          {
            "role": "button",
            "name": "Open Settings"
          },
          {
            "role": "searchbox",
            "name": "Search settings",
            "fill": "Control Room updates"
          }
        ],
        "linux-font": [
          {
            "role": "button",
            "name": "Open Settings"
          },
          {
            "role": "searchbox",
            "name": "Search settings",
            "fill": "Font family"
          }
        ]
      },
      "settled": {
        "populated": ".settings-page",
        "monitoring": ".settings-page",
        "logs": ".settings-page",
        "diagnostics": ".settings-ssh",
        "update-failed": ".settings-update-error",
        "save-failed": ".settings-status.failed",
        "linux-package": ".settings-page button:has-text('Open releases')",
        "linux-font": ".settings-page .terminal-appearance-controls input[type='number']"
      },
      "motion": {
        "description": "Settings category reveal, General to Terminal",
        "target": ".settings-form",
        "button": "Terminal",
        "select": "Settings category",
        "option": "terminal"
      }
    },
    "scratchpad": {
      "states": ["populated", "global", "save-error"],
      "ready": ".app-shell",
      "prepare": {
        "populated": [
          {
            "selector": "[data-scratchpad-trigger]"
          }
        ],
        "global": [
          {
            "selector": "[data-scratchpad-trigger]"
          },
          {
            "role": "button",
            "name": "Global note for all connections"
          }
        ],
        "save-error": [
          {
            "selector": "[data-scratchpad-trigger]"
          },
          {
            "role": "textbox",
            "name": "Connection note",
            "fill": "systemctl restart worker.service"
          }
        ]
      },
      "settled": {
        "populated": ".scratchpad-popover textarea[aria-label='Connection note']",
        "global": ".scratchpad-popover textarea[aria-label='Global note']",
        "save-error": ".scratchpad-save-error"
      },
      "motion": {
        "description": "Scratchpad note switch, Connection to Global",
        "target": ".scratchpad-popover-note:not([hidden])",
        "button": "Global note for all connections",
        "select": "Scratchpad scope",
        "option": "global"
      }
    },
    "dialogs": {
      "states": [
        "connection",
        "connection-error",
        "connection-test",
        "connection-test-error",
        "groups",
        "groups-no-tags",
        "rename",
        "metrics"
      ],
      "ready": ".app-shell",
      "prepare": {
        "connection": [
          {
            "selector": ".compact-navigation-toggle",
            "optional": true
          },
          {
            "role": "button",
            "name": "Add connection"
          }
        ],
        "connection-error": [
          {
            "selector": ".compact-navigation-toggle",
            "optional": true
          },
          {
            "role": "button",
            "name": "Add connection"
          },
          {
            "selector": ".connection-form button[type='submit']"
          }
        ],
        "connection-test": [
          {
            "selector": ".compact-navigation-toggle",
            "optional": true
          },
          {
            "selector": ".host-row",
            "hover": true
          },
          {
            "role": "button",
            "name": "Open actions for Example host"
          },
          {
            "role": "menuitem",
            "name": "Edit connection"
          },
          {
            "role": "button",
            "name": "Test structured access"
          }
        ],
        "connection-test-error": [
          {
            "selector": ".compact-navigation-toggle",
            "optional": true
          },
          {
            "selector": ".host-row",
            "hover": true
          },
          {
            "role": "button",
            "name": "Open actions for Example host"
          },
          {
            "role": "menuitem",
            "name": "Edit connection"
          },
          {
            "role": "button",
            "name": "Test structured access"
          }
        ],
        "groups": [
          {
            "selector": ".compact-navigation-toggle",
            "optional": true
          },
          {
            "role": "button",
            "name": "Manage groups and tags"
          }
        ],
        "groups-no-tags": [
          {
            "selector": ".compact-navigation-toggle",
            "optional": true
          },
          {
            "role": "button",
            "name": "Manage groups and tags"
          }
        ],
        "rename": [
          {
            "selector": ".session-tab-main"
          },
          {
            "role": "button",
            "name": "Rename Example host Workspace"
          }
        ],
        "metrics": [
          {
            "selector": ".host-metrics-trigger"
          }
        ]
      },
      "settled": {
        "connection": ".modal.connection-dialog",
        "connection-error": ".connection-form .inline-error",
        "connection-test": ".connection-form [role='status']",
        "connection-test-error": ".connection-form .inline-error",
        "groups-no-tags": ".connection-groups-dialog .connection-tag-create",
        "groups": ".connection-groups-dialog .connection-tag-manage-list:not(:empty)",
        "rename": ".modal.prompt-dialog",
        "metrics": ".host-metrics-panel"
      }
    },
    "terminal": {
      "states": ["find", "find-matches", "find-none", "notice-error", "notice-ended"],
      "ready": ".app-shell",
      "prepare": {
        "find": [
          {
            "role": "button",
            "name": "Find in terminal"
          }
        ],
        "find-matches": [
          {
            "role": "button",
            "name": "Find in terminal"
          },
          {
            "role": "textbox",
            "name": "Find in terminal output",
            "fill": "worker"
          }
        ],
        "notice-error": [
          {
            "role": "button",
            "name": "Paste into terminal"
          }
        ],
        "find-none": [
          {
            "role": "button",
            "name": "Find in terminal"
          },
          {
            "role": "textbox",
            "name": "Find in terminal output",
            "fill": "panic"
          }
        ]
      },
      "settled": {
        "find": ".terminal-search",
        "find-matches": ".terminal-search",
        "find-none": ".terminal-search",
        "notice-error": ".terminal-notice",
        "notice-ended": ".terminal-notice"
      }
    },
    "pages": {
      "states": ["docker", "logs", "history"],
      "ready": ".app-shell",
      "settled": {
        "docker": ".docker-page",
        "logs": ".log-output",
        "history": ".history-list"
      }
    },
    "ports": {
      "states": ["warnings"],
      "ready": ".app-shell",
      "settled": {
        "warnings": "[role='region'][aria-label='Ports reading warnings']"
      }
    },
    "systemd": {
      "states": ["populated", "empty", "loading", "error", "stale", "overflow"],
      "ready": ".app-shell",
      "prepare": {
        "populated": [
          {
            "selector": ".systemd-inventory .dense-row",
            "last": true
          }
        ],
        "stale": [
          {
            "selector": ".systemd-inventory .dense-row",
            "last": true
          },
          {
            "role": "button",
            "name": "Refresh systemd units"
          }
        ],
        "overflow": [
          {
            "selector": ".systemd-inventory .dense-row",
            "last": true
          }
        ]
      },
      "settled": {
        "populated": ".systemd-memory-value > [aria-hidden]",
        "stale": ".systemd-page .inline-warning",
        "overflow": ".systemd-memory-value > [aria-hidden]",
        "loading": ".connection-section .panel-state[aria-live]",
        "empty": ".systemd-inventory .panel-state",
        "error": ".connection-section .panel-state-error"
      }
    },
    "logs": {
      "states": ["stopped", "populated", "errors", "search", "restricted"],
      "ready": ".app-shell",
      "prepare": {
        "populated": [
          {
            "role": "button",
            "name": "Start"
          }
        ],
        "restricted": [
          {
            "role": "button",
            "name": "Start"
          }
        ],
        "errors": [
          {
            "role": "button",
            "name": "Start"
          },
          {
            "selector": ".log-line[data-level='error']",
            "wait": true
          },
          {
            "selector": ".log-level-filter [data-level='error']"
          }
        ],
        "search": [
          {
            "role": "button",
            "name": "Start"
          },
          {
            "selector": ".log-line[data-level='error']",
            "wait": true
          },
          {
            "role": "textbox",
            "name": "Search loaded lines",
            "fill": "batch 4813"
          }
        ]
      },
      "settled": {
        "stopped": ".logs-page .log-empty",
        "populated": ".logs-page .log-line:nth-child(49)",
        "errors": ".log-level-filter [data-level='error'][aria-pressed='true']",
        "search": ".logs-page .log-match-count",
        "restricted": ".logs-page .inline-warning[role='status']"
      }
    }
  }
}
