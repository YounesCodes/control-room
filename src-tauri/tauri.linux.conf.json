{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "Control Room",
        "width": 1180,
        "height": 700,
        "minWidth": 520,
        "minHeight": 480,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "capabilities": ["default", "linux-window"]
    }
  },
  "bundle": {
    "targets": ["deb", "appimage"],
    "icon": ["icons/icon.png"],
    "linux": {
      "deb": {
        "depends": ["openssh-client", "xdg-utils"]
      }
    }
  }
}
