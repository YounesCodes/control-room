{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "npm run build:e2e"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Control Room",
        "width": 1180,
        "height": 700,
        "minWidth": 960,
        "minHeight": 640,
        "create": false,
        "decorations": false
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "desktop-e2e",
          "description": "WebdriverIO access in debug desktop E2E builds only",
          "windows": ["main"],
          "permissions": ["wdio:default"]
        },
        {
          "identifier": "desktop-e2e-macos",
          "description": "Embedded driver in debug macOS desktop tests only",
          "windows": ["main"],
          "platforms": ["macOS"],
          "permissions": ["wdio-webdriver:default", "core:window:allow-set-focus"]
        }
      ]
    }
  }
}
